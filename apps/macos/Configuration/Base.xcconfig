MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
PRODUCT_NAME = Requestman
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
PRODUCT_BUNDLE_IDENTIFIER = com.requestman.macos
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Requestman
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.developer-tools
INFOPLIST_KEY_NSPrincipalClass = NSApplication
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_STYLE = Automatic
// Keep the development identity stable across rebuilds for Keychain authorization.
// Copy Signing.local.xcconfig.example and select your own development team.
#include? "Signing.local.xcconfig"
